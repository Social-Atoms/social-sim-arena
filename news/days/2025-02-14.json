  "items": [
    {
      "category": "Armed conflicts and attacks",
      "text": "M23 rebels and Rwandan troops seize control of Kavumu Airport in South Kivu, Democratic Republic of the Congo. ((DW))"
    },
    {
      "category": "Armed conflicts and attacks",
      "text": "M23 forces and Rwandan troops enter the city of Bukavu, according to local security and humanitarian officials. There are no reports of resistance as most Congolese troops withdraw. ((Digital Journal))"
    },
    {
      "category": "Armed conflicts and attacks",
      "text": "Congolese president Félix Tshisekedi cancels his participation in an upcoming African Union summit to end the conflict due to the \"situation on the ground\". Tshisekedi accuses Rwanda of invading the country to seize its mineral-rich regions. ((RFI))"
    },
    {
      "category": "Armed conflicts and attacks",
      "text": "A drone strikes the New Safe Confinement structure housing the site of the Chernobyl disaster. Ukrainian President Volodymyr Zelenskyy states that a Russian combat drone caused significant damage to the structure, but did not produce an increase in external radiation levels. ((CNN))"
    },
    {
      "category": "Armed conflicts and attacks",
      "text": "Eleven coal miners are killed and five others are wounded when a bomb hits a truck in Harnai, Balochistan, Pakistan. ((AP))"
    },
    {
      "category": "Disasters and accidents:",
      "text": "At least six people are killed and seven injured in a fire at a construction site in Busan, South Korea. ((Al Jazeera))"
    },
    {
      "category": "Disasters and accidents:",
      "text": "Ten people are killed and 19 others are injured in a collision between a car and a bus carrying Hindu pilgrims heading to Kumbh Mela in Prayagraj, Uttar Pradesh, India. ((DW))"
    },
    {
      "category": "Disasters and accidents:",
      "text": "A shop explosion and fire in Oudomxay province, Laos, kills four people and injures others. ((Radio Free Asia))"
    }
