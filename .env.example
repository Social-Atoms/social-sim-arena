# Production. A fine-grained token whose only permission is contents:write on
# the private intake repository. Scope it to Production alone: every preview
# deploys to the same Vercel project, and a preview must not write real
# submissions. Never commit a real value.
INTAKE_REPO_TOKEN=

# Read only when INTAKE_REPO_TOKEN is unset. Vercel sets this automatically.
BLOB_READ_WRITE_TOKEN=

# Local development/tests only. Keep this directory ignored by Git.
SUBMISSION_STORAGE_DIR=.local/submissions

# One per entrant that uploads a bundle, named for its entrant id with every
# character outside A-Z0-9 replaced by an underscore: entrant `acme-forecast`
# reads `SSA_UPLOAD_KEY_ACME_FORECAST`. Not the same secret as
# `SSA_ENTRANT_KEY_<ID>`, which the arena sends to the participant's own
# endpoint. Never commit a real value.
SSA_UPLOAD_KEY_<ENTRANT_ID>=

# Optional comma-separated browser origins in addition to the request host.
SUBMISSION_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
