    given-names: Cedegao E.
    affiliation: "MIT; Social Atoms"
  - family-names: Jiang
    given-names: Hang
    affiliation: "Northeastern University; Social Atoms; Harvard IQSS"
  - name: "Social Atoms"
    website: "https://social-atoms.org"
repository-code: "https://github.com/Social-Atoms/social-sim-arena"
url: "https://social-simulation-arena.com"
date-released: "2026-08-14"
version: "season-0"
keywords:
