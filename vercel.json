{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "{site/data.json,schema/*.schema.json,ssa/questionnaire_api.py,tools/validate_submission.py,entrants/*.json,questions/bundles/*.json}"
      }
    },
    {"src": "site/**", "use": "@vercel/static"}
  ],
  "rewrites": [
    {"source": "/api/v1/questionnaire", "destination": "/api/questionnaire.py"},
    {"source": "/api/v1/questionnaire-submissions", "destination": "/api/questionnaire_submissions.py"},
    {"source": "/api/v1/bundle-submissions", "destination": "/api/bundle_submissions.py"},
    {"source": "/", "destination": "/site/index.html"},
    {"source": "/(.*)", "destination": "/site/$1"}
  ],
  "redirects": [
    {"source": "/(.*)", "has": [{"type": "host", "value": "socialsimarena.com"}], "destination": "https://social-simulation-arena.com/$1", "permanent": true},
    {"source": "/(.*)", "has": [{"type": "host", "value": "www.socialsimarena.com"}], "destination": "https://social-simulation-arena.com/$1", "permanent": true},
    {"source": "/(.*)", "has": [{"type": "host", "value": "www.social-simulation-arena.com"}], "destination": "https://social-simulation-arena.com/$1", "permanent": true}
  ]
}
