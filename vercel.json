{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "ui/site-refinement": false,
      "sealed": false
    }
  },
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "{site/data.json,schema/*.schema.json,schema/reserved-entrant-ids.json,ssa/**,tools/validate_submission.py,entrants/*.json,site/keys.json,examples/agent-api/server.py,questions/season0.json,questions/bundles/*.json}"
      }
    },
    {
      "src": "site/**",
      "use": "@vercel/static"
    },
    {
      "src": "404.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/forecasts",
      "dest": "/api/forecasts.py"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "socialsimarena.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://social-simulation-arena.com/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.socialsimarena.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://social-simulation-arena.com/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.social-simulation-arena.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://social-simulation-arena.com/$1"
      }
    },
    {
      "src": "/api/v1/questionnaire",
      "dest": "/api/questionnaire.py"
    },
    {
      "src": "/api/v1/questionnaire-submissions",
      "dest": "/api/questionnaire_submissions.py"
    },
    {
      "src": "/api/v1/bundle-submissions",
      "dest": "/api/bundle_submissions.py"
    },
    {
      "src": "/api/example-agent",
      "dest": "/api/example_agent.py"
    },
    {
      "src": "/leaderboard.html",
      "status": 308,
      "headers": {
        "Location": "/#leaderboard"
      }
    },
    {
      "src": "/",
      "dest": "/site/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/site/$1",
      "check": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
