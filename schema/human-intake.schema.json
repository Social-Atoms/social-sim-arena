{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Social Simulation Arena human wisdom intake",
  "type": "object",
  "required": ["username", "contact_email", "questionnaire", "publication_consent"],
  "additionalProperties": false,
  "properties": {
    "username": {"type": "string", "minLength": 2, "maxLength": 80},
    "contact_email": {"type": "string", "format": "email", "maxLength": 160},
    "questionnaire": {"type": "string", "minLength": 40, "maxLength": 4000},
    "publication_consent": {
      "type": "object",
      "required": ["accepted", "field", "terms_version"],
      "additionalProperties": false,
      "properties": {
        "accepted": {"type": "boolean"},
        "field": {"const": "username"},
        "terms_version": {"const": "ssa-publication-v1"}
      }
    }
  }
}
