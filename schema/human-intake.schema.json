{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Social Simulation Arena Human Wisdom board submission",
  "type": "object",
  "required": [
    "submission_version",
    "board_id",
    "round_manifest",
    "username",
    "contact_email",
    "answers",
    "commitment",
    "publication_consent"
  ],
  "definitions": {
    "round_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "questionnaire_answer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["round_id", "target_type", "response"],
          "additionalProperties": false,
          "properties": {
            "round_id": {"$ref": "#/definitions/round_id"},
            "target_type": {"const": "continuous_normal"},
            "response": {
              "type": "object",
              "required": ["value"],
              "additionalProperties": false,
              "properties": {"value": {"type": "number"}}
            }
          }
        },
        {
          "type": "object",
          "required": ["round_id", "target_type", "response"],
          "additionalProperties": false,
          "properties": {
            "round_id": {"$ref": "#/definitions/round_id"},
            "target_type": {"const": "binary_probability"},
            "response": {
              "type": "object",
              "required": ["choice"],
              "additionalProperties": false,
              "properties": {"choice": {"enum": ["Yes", "No"]}}
            }
          }
        },
        {
          "type": "object",
          "required": ["round_id", "target_type", "response"],
          "additionalProperties": false,
          "properties": {
            "round_id": {"$ref": "#/definitions/round_id"},
            "target_type": {"const": "multiple_choice"},
            "response": {
              "type": "object",
              "required": ["choice"],
              "additionalProperties": false,
              "properties": {"choice": {"type": "string", "minLength": 1, "maxLength": 160}}
            }
          }
        },
        {
          "type": "object",
          "required": ["round_id", "target_type", "response"],
          "additionalProperties": false,
          "properties": {
            "round_id": {"$ref": "#/definitions/round_id"},
            "target_type": {"const": "short_answer"},
            "response": {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 300}}
            }
          }
        },
        {
          "type": "object",
          "required": ["round_id", "target_type", "response"],
          "additionalProperties": false,
          "properties": {
            "round_id": {"$ref": "#/definitions/round_id"},
            "target_type": {"const": "ranking_list"},
            "response": {
              "type": "object",
              "required": ["ranking"],
              "additionalProperties": false,
              "properties": {
                "ranking": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 50,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 256}
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["round_id", "target_type", "response"],
          "additionalProperties": false,
          "properties": {
            "round_id": {"$ref": "#/definitions/round_id"},
            "target_type": {"const": "profile_energy"},
            "response": {
              "type": "object",
              "required": ["profile"],
              "additionalProperties": false,
              "properties": {
                "profile": {
                  "type": "object",
                  "minProperties": 2,
                  "propertyNames": {"pattern": "^[a-z][a-z0-9_]{2,63}$"},
                  "additionalProperties": {"type": "number"}
                }
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "submission_version": {"const": 1},
    "board_id": {"enum": ["topline", "profile", "ranking"]},
    "round_manifest": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/round_id"}
    },
    "username": {"type": "string", "minLength": 2, "maxLength": 80},
    "contact_email": {"type": "string", "format": "email", "maxLength": 160},
    "answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/definitions/questionnaire_answer"}
    },
    "commitment": {
      "type": "object",
      "required": ["accepted", "terms_version"],
      "additionalProperties": false,
      "properties": {
        "accepted": {"const": true},
        "terms_version": {"const": "ssa-participant-v1"}
      }
    },
    "publication_consent": {
      "type": "object",
      "required": ["accepted", "field", "terms_version"],
      "additionalProperties": false,
      "properties": {
        "accepted": {"type": "boolean"},
        "field": {"const": "username"},
        "terms_version": {"const": "ssa-publication-v1"}
      }
    }
  }
}
