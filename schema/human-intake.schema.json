{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Social Simulation Arena human forecast intake",
  "type": "object",
  "required": ["username", "email", "round_id", "topline", "consent"],
  "additionalProperties": false,
  "properties": {
    "username": {"type": "string", "minLength": 2, "maxLength": 80},
    "email": {"type": "string", "format": "email", "maxLength": 160},
    "round_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "topline": {
      "type": "object",
      "required": ["mean", "sd"],
      "additionalProperties": false,
      "properties": {
        "mean": {"type": "number"},
        "sd": {"type": "number", "exclusiveMinimum": 0, "maximum": 50}
      }
    },
    "notes": {"type": "string", "maxLength": 500},
    "consent": {
      "type": "object",
      "required": ["accepted", "terms_version"],
      "additionalProperties": false,
      "properties": {
        "accepted": {"const": true},
        "terms_version": {"const": "ssa-human-v1"}
      }
    }
  }
}
