{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Social Simulation Arena predictive agent intake",
  "type": "object",
  "required": [
    "participant_type",
    "organization_name",
    "product_name",
    "contact",
    "publication_consent",
    "delivery"
  ],
  "definitions": {
    "questionnaire_answer": {
      "oneOf": [
        {
          "type": "object",
          "required": ["round_id", "target_type", "response"],
          "additionalProperties": false,
          "properties": {
            "round_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
            "target_type": {"const": "continuous_normal"},
            "response": {
              "type": "object",
              "required": ["mean", "sd"],
              "additionalProperties": false,
              "properties": {
                "mean": {"type": "number"},
                "sd": {"type": "number", "exclusiveMinimum": 0, "maximum": 50}
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["round_id", "target_type", "response"],
          "additionalProperties": false,
          "properties": {
            "round_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
            "target_type": {"const": "binary_probability"},
            "response": {
              "type": "object",
              "required": ["probability"],
              "additionalProperties": false,
              "properties": {"probability": {"type": "number", "minimum": 0, "maximum": 1}}
            }
          }
        },
        {
          "type": "object",
          "required": ["round_id", "target_type", "response"],
          "additionalProperties": false,
          "properties": {
            "round_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
            "target_type": {"const": "multiple_choice"},
            "response": {
              "type": "object",
              "required": ["choice"],
              "additionalProperties": false,
              "properties": {"choice": {"type": "string", "minLength": 1, "maxLength": 160}}
            }
          }
        },
        {
          "type": "object",
          "required": ["round_id", "target_type", "response"],
          "additionalProperties": false,
          "properties": {
            "round_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
            "target_type": {"const": "short_answer"},
            "response": {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 300}}
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "participant_type": {
      "type": "string",
      "enum": ["startup", "research_group", "institution", "individual_researcher"]
    },
    "organization_name": {"type": "string", "minLength": 2, "maxLength": 120},
    "product_name": {"type": "string", "minLength": 2, "maxLength": 120},
    "contact": {
      "type": "object",
      "required": ["name", "email"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 2, "maxLength": 100},
        "email": {"type": "string", "format": "email", "maxLength": 160}
      }
    },
    "publication_consent": {
      "type": "object",
      "required": ["accepted", "fields", "terms_version"],
      "additionalProperties": false,
      "properties": {
        "accepted": {"type": "boolean"},
        "fields": {
          "type": "array",
          "items": [
            {"const": "organization_name"},
            {"const": "product_name"}
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "terms_version": {"const": "ssa-publication-v1"}
      }
    },
    "delivery": {
      "oneOf": [
        {
          "type": "object",
          "required": ["method", "endpoint", "credential_supplied"],
          "additionalProperties": false,
          "properties": {
            "method": {"const": "openai_compatible_api"},
            "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
            "credential_supplied": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "required": ["method", "answers", "commitment"],
          "additionalProperties": false,
          "properties": {
            "method": {"const": "questionnaire_commitment"},
            "answers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {"$ref": "#/definitions/questionnaire_answer"}
            },
            "commitment": {
              "type": "object",
              "required": ["accepted", "terms_version"],
              "additionalProperties": false,
              "properties": {
                "accepted": {"const": true},
                "terms_version": {"const": "ssa-participant-v1"}
              }
            }
          }
        }
      ]
    }
  }
}
