{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Social Simulation Arena predictive agent intake",
  "type": "object",
  "required": [
    "participant_type",
    "organization_name",
    "product_name",
    "contact",
    "publication_consent",
    "delivery"
  ],
  "additionalProperties": false,
  "properties": {
    "participant_type": {
      "type": "string",
      "enum": ["startup", "research_group", "institution", "individual_researcher"]
    },
    "organization_name": {"type": "string", "minLength": 2, "maxLength": 120},
    "product_name": {"type": "string", "minLength": 2, "maxLength": 120},
    "contact": {
      "type": "object",
      "required": ["name", "email"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 2, "maxLength": 100},
        "email": {"type": "string", "format": "email", "maxLength": 160}
      }
    },
    "publication_consent": {
      "type": "object",
      "required": ["accepted", "fields", "terms_version"],
      "additionalProperties": false,
      "properties": {
        "accepted": {"type": "boolean"},
        "fields": {
          "type": "array",
          "items": [
            {"const": "organization_name"},
            {"const": "product_name"}
          ],
          "additionalItems": false,
          "minItems": 2,
          "maxItems": 2
        },
        "terms_version": {"const": "ssa-publication-v1"}
      }
    },
    "delivery": {
      "oneOf": [
        {
          "type": "object",
          "required": ["method", "endpoint", "credential_supplied"],
          "additionalProperties": false,
          "properties": {
            "method": {"const": "openai_compatible_api"},
            "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
            "credential_supplied": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "required": ["method", "questionnaire", "commitment"],
          "additionalProperties": false,
          "properties": {
            "method": {"const": "questionnaire_commitment"},
            "questionnaire": {"type": "string", "minLength": 40, "maxLength": 4000},
            "commitment": {
              "type": "object",
              "required": ["accepted", "terms_version"],
              "additionalProperties": false,
              "properties": {
                "accepted": {"const": true},
                "terms_version": {"const": "ssa-participant-v1"}
              }
            }
          }
        }
      ]
    }
  }
}
