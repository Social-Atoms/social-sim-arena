{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SSA Agent API decoded response v1",
  "description": "The reply body a participant endpoint returns: one JSON object, no wrapper.",
  "type": "object",
  "required": [
    "schema_version",
    "forecast"
  ],
  "additionalProperties": false,
  "definitions": {
    "distribution": {
      "type": "object",
      "description": "A normal: a mean and a strictly positive sd, scored with CRPS (a topline) or pooled into the energy score (a profile cell). A point guess is not a forecast and is refused. Quantile sets are not accepted from an endpoint -- schema/forecast.schema.json still allows one in a committed file, but the live contract is one shape. On a round marked \"scoring\": \"grid21\" the answer may instead be `quantile_grid` (21 values at fixed levels; see that property), never both.",
      "additionalProperties": false,
      "properties": {
        "mean": {
          "type": "number"
        },
        "sd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000
        },
        "quantile_grid": {
          "type": "array",
          "minItems": 21,
          "maxItems": 21,
          "items": {
            "type": "number"
          },
          "description": "The forecast's quantiles at the 21 fixed levels (i - 1/2)/21, i = 1..21 (2.381% .. 97.619%; the 11th value is the median), non-decreasing. Accepted only on rounds marked \"scoring\": \"grid21\"; replaces mean and sd, never accompanies them."
        }
      },
      "oneOf": [
        {
          "required": [
            "mean",
            "sd"
          ],
          "not": {
            "required": [
              "quantile_grid"
            ]
          }
        },
        {
          "required": [
            "quantile_grid"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "mean"
                ]
              },
              {
                "required": [
                  "sd"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "ssa-agent-api-v2"
    },
    "forecast": {
      "oneOf": [
        {
          "$ref": "#/definitions/distribution"
        },
        {
          "type": "object",
          "required": [
            "probabilities"
          ],
          "additionalProperties": false,
          "properties": {
            "probabilities": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "profile"
          ],
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "$ref": "#/definitions/distribution"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ranking"
          ],
          "additionalProperties": false,
          "properties": {
            "ranking": {
              "type": "array",
              "minItems": 2,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      ]
    },
    "reasoning_trace": {
      "type": "string",
      "maxLength": 20000
    },
    "crosstabs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 2,
        "additionalProperties": {
          "$ref": "#/definitions/distribution"
        }
      }
    }
  }
}
