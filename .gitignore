__pycache__/
*.pyc
.DS_Store
paper/

# Provider credentials. Keys live here for local runs and in GitHub Actions
# secrets for CI -- never in the tree. The glob covers .env.local, .env.bak and
# the rest, since one stray `git add -A` is all it takes.
.env
.env.*
!.env.example

# Kept local at the maintainer's request, not pushed. These exercise the
# provider harness and are useful while wiring keys; remove these three lines
# to start publishing them.
tests/test_harness.py
tests/test_model_backtest.py
tools/check_provider.py
.vercel

# Per-call working cache for the LLM backtest: one file per call, which is
# right for resuming an interrupted run and wrong for a repository. The
# committed evidence is backtest/runs/*.jsonl, the same content consolidated.
cache/

# News page fetch cache. The per-round digests under news/rounds/ are the audit
# record and are committed; these are just the raw pages they were built from.
news/pages/
